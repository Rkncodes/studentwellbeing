# Copy this file to .env in the project root and fill in your own values.
# .env is gitignored — never commit a real key.

# Required for the Groq provider. Leave unset to run on the mock provider only.
GROQ_API_KEY=

# "groq" or "mock". If unset, defaults to "groq" when GROQ_API_KEY is set,
# otherwise "mock". Set explicitly to "mock" to force the keyword-rule
# triage even when a key is present.
TRIAGE_PROVIDER=

# Groq model id. Defaults to openai/gpt-oss-20b if unset.
TRIAGE_MODEL=openai/gpt-oss-20b

# Port the backend triage server listens on. The Vite dev proxy expects 8787.
PORT=8787
